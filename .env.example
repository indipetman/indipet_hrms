# Copy these values into the deployment environment. Do not commit a real .env file.
INDIPET_RUNTIME_MODE=production
INDIPET_BOOTSTRAP_USER_ID=replace-with-first-run-user-id
INDIPET_BOOTSTRAP_PASSWORD=replace-with-a-strong-secret-of-at-least-12-characters
# Optional persistent production database directory:
# INDIPET_PRODUCTION_DATA_ROOT=C:\\indipet-data
